# Copy file này thành .env rồi điền giá trị thật cho môi trường của bạn.
# .env bị .gitignore chặn — KHÔNG BAO GIỜ commit file .env thật (chứa secret).
# Mọi biến dưới đây đã có giá trị mặc định an toàn cho dev trong application.yml /
# docker-compose.yml — chỉ cần tạo .env khi bạn muốn đổi khác giá trị mặc định.

# --- Database (Postgres, xem docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic_booking
DB_USERNAME=clinic
DB_PASSWORD=clinic

# --- Mail (Mailpit ở dev — không gửi email thật; đổi sang SMTP thật khi lên prod) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CORS: domain của FE ReactJS được phép gọi API, phân tách bằng dấu phẩy ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Spring profile đang chạy: dev | test | prod ---
SPRING_PROFILES_ACTIVE=dev
